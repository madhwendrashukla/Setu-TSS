# ─── Database (website's own DB on the shared RDS instance) ─────────────────
DATABASE_URL="postgresql://postgres:PASSWORD@setu-prod-db.cpeg6saai34i.ap-south-1.rds.amazonaws.com:5432/postgres"

# ─── Server ──────────────────────────────────────────────────────────────────
# Production runs on 5000 (nginx proxies /api/ there). Local dev may use 5001
# together with web/.env.local NEXT_PUBLIC_API_URL=http://localhost:5001.
PORT=5000
FRONTEND_URL="https://foundersschool.in"

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="generate: openssl rand -hex 32"
ADMIN_PASSWORD="set-before-running-seed.js"

# ─── AWS S3 uploads ──────────────────────────────────────────────────────────
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME=""

# ─── Email (optional — falls back to Ethereal in dev) ────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
CONTACT_EMAIL=""

# ─── LMS integration ─────────────────────────────────────────────────────────
# Read-only connection to the LMS's jjlms database on the same RDS instance.
# MUST use the website_ro role (SELECT-only grants) — never the LMS app role.
LMS_DATABASE_URL_RO="postgresql://website_ro:PASSWORD@setu-prod-db.cpeg6saai34i.ap-south-1.rds.amazonaws.com:5432/jjlms"

# Enrollment webhook receiver inside the LMS container (loopback on the VPS;
# note the /lms basePath applies to API routes too).
LMS_WEBHOOK_URL="http://127.0.0.1:3001/lms/api/webhooks/enrollment"

# Shared HMAC secret — same value as WEBHOOK_SECRET in the LMS env.
# Generate once: openssl rand -hex 32. Exchange via password manager only.
LMS_WEBHOOK_SECRET=""

# ─── Razorpay (website owns the merchant keys; the LMS never sees them) ──────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
